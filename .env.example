# Copy to .env and fill in. Never commit .env.
HTTP_PORT=8095
# Host interface the port binds to. Keep 127.0.0.1 when fronted by cloudflared on the same host.
BIND_ADDR=127.0.0.1
DB_HOST=consolidated-mysql
DB_PORT=3306
DB_NAME=kangpaket
DB_USER=kangpaket
DB_PASSWORD=change-me
# At least 32 characters (use e.g. `openssl rand -base64 48`)
JWT_SECRET=change-me-to-a-long-random-string
REGISTRATION_ENABLED=false
# Auth (defaults shown)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# Set true ONLY when every request arrives via Cloudflare Tunnel (port bound to 127.0.0.1):
# then the CF-Connecting-IP header is used as the client IP for rate limiting. Otherwise clients can spoof it.
TRUST_PROXY_HEADERS=false
# Comma-separated origins; empty = CORS off (desktop app does not need it)
CORS_ALLOWED_ORIGINS=
# Attempts per minute, per client IP and (login only) per username
RATE_LIMIT_PER_MIN=5
RATE_LIMIT_USER_PER_MIN=5
