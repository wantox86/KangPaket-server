# Copy to .env and fill in. Never commit .env.
HTTP_PORT=8095
DB_HOST=consolidated-mysql
DB_PORT=3306
DB_NAME=kangpaket
DB_USER=kangpaket
DB_PASSWORD=change-me
# At least 32 characters (use e.g. `openssl rand -base64 48`)
JWT_SECRET=change-me-to-a-long-random-string
REGISTRATION_ENABLED=false
# Auth (defaults shown)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# Set true only behind Cloudflare Tunnel: trusts the CF-Connecting-IP header for rate limiting
TRUST_PROXY_HEADERS=false
# Comma-separated origins; empty = CORS off (desktop app does not need it)
CORS_ALLOWED_ORIGINS=
# Attempts per minute, per client IP and (login only) per username
RATE_LIMIT_PER_MIN=5
RATE_LIMIT_USER_PER_MIN=5
